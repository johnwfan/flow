SMARTSPECTRA_API_KEY=your-presage-api-key-here

# Windows camera friendly name to require/prefer for live sensing.
# The agent still probes SmartSpectra's numeric indices, then remembers the
# last-good index for this named camera.
FLOW_SENSING_CAMERA_NAME=HD Webcam

# Optional: force a SmartSpectra index to try before the remembered/default
# order if the SDK's camera ordering changes on your machine.
# FLOW_SENSING_CAMERA_INDEX=1

# Where the agent POSTs sessions/batches. Defaults to http://localhost:3001
# if unset. Set this to the deployed API (e.g. https://tryflow.study) so a
# locally-run agent's sessions show up on the live dashboard instead of a
# local API that probably isn't running.
API_BASE_URL=https://tryflow.study
