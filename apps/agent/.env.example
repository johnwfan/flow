SMARTSPECTRA_API_KEY=your-presage-api-key-here

# Where the agent POSTs sessions/batches. Defaults to http://localhost:3001
# if unset. Set this to the deployed API (e.g. https://tryflow.study) so a
# locally-run agent's sessions show up on the live dashboard instead of a
# local API that probably isn't running.
API_BASE_URL=https://tryflow.study
