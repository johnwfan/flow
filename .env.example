# Tiger Cloud (TimescaleDB) connection string
TIGER_CLOUD_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Google Gemini API key (session narratives, cross-session insights)
GEMINI_API_KEY=

# ElevenLabs API key (TTS proxy for breathing-guide/nudge audio)
ELEVENLABS_API_KEY=

# ElevenLabs voice ID to use (from https://elevenlabs.io/app/voices ->
# voice's ... menu -> Copy Voice ID). Falls back to a stock voice if unset.
ELEVENLABS_VOICE_ID=

# Vultr instance SSH target (user@host), used by infra/deploy.sh
VULTR_SSH_HOST=

# Browser-side API base URL for apps/web client components (e.g. the /break
# page's fetch to /v1/speak). Leave unset in production — Caddy proxies /v1/*
# on the same origin (infra/Caddyfile), so the relative default is correct
# there. Local dev needs this since web (:3000) and api (:3001) aren't proxied.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Device id used by the web history/insights pages. Leave as all to show every
# completed session; set to demo-device for a seed-history-only demo view.
FLOW_HISTORY_DEVICE_ID=all

# Agent-side API base URL (apps/agent) -- where it POSTs sessions/batches.
# Defaults to http://localhost:3001 if unset; only needed if the API runs
# somewhere else (e.g. pointing a local agent at the deployed Vultr API).
API_BASE_URL=http://localhost:3001

# Browser-side agent WebSocket URL for the live /session page. Defaults to
# ws://localhost:8765 if unset -- only needed if the agent runs elsewhere.
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8765
