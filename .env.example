# Tiger Cloud (TimescaleDB) connection string
TIGER_CLOUD_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Google Gemini API key (session narratives, cross-session insights)
GEMINI_API_KEY=

# ElevenLabs API key (TTS proxy for breathing-guide/nudge audio)
ELEVENLABS_API_KEY=

# Vultr instance SSH target (user@host), used by infra/deploy.sh
VULTR_SSH_HOST=

# Browser-side API base URL for apps/web client components (e.g. the /break
# page's fetch to /v1/speak). Leave unset in production — Caddy proxies /v1/*
# on the same origin (infra/Caddyfile), so the relative default is correct
# there. Local dev needs this since web (:3000) and api (:3001) aren't proxied.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
